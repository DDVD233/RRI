# Deployment settings for the RRI pipeline (train/rri_pipeline.sh, train/run_rri.sh,
# eval/eval_rri.sh). Copy to scripts/self_evolving/.env (gitignored) or to any file
# named by RRI_ENV_FILE, and fill in what you use. Values set in the environment win
# over the file. Lines are plain KEY=value; $VAR references to earlier keys work.

# ---- teacher / judge model ---------------------------------------------------------
# Proposer, rubric writer, adversary, repair step, meta-optimizer and (unless
# JUDGE=self) the training and validation judge. Any OpenAI-compatible endpoint.
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=                 # or LLM_API_KEY_FILE=/path/to/key; falls back to OPENAI_API_KEY
LLM_MODEL=                   # required, e.g. the GPT-5-family model you have access to
# openai: GPT-5-family request shape (max_completion_tokens, no temperature)
# vllm:   a local vLLM server (temperature 0, Qwen thinking switched off for judging)
LLM_PROVIDER=openai
# Reasoning effort sent on non-thinking calls to non-"chat" GPT models; "" omits it
# (needed for models that reject "none", e.g. o-series).
# NO_THINK_REASONING_EFFORT=none

# ---- frozen model (evidence summarizer + self-judge) ------------------------------
# Used when the knowledge-base tool is on or JUDGE=self/self_all. Without FROZEN_BASE,
# run_rri.sh starts it on GPU $FROZEN_GPU of the training node.
# FROZEN_BASE=http://localhost:8199/v1
# FROZEN_MODEL=Qwen/Qwen3.5-9B
# FROZEN_GPU=3

# ---- knowledge base (scripts/self_evolving/kb/) -----------------------------------
# KB=0 runs without one (tasks are generated ungrounded; TOOLS=web or none).
KB=1
EMBED_BASE=http://localhost:18001/v1      # serve/start_embedding_server.sh
EMBED_MODEL=Qwen/Qwen3-VL-Embedding-2B
EMBED_API_KEY=EMPTY
MILVUS_URI=http://localhost:19530         # kb/milvus/docker-compose.yml
MILVUS_TOKEN=root:Milvus                  # change the default password before exposing Milvus
MILVUS_COLLECTION=medical_knowledge_v2
# PUBMED_TITLES_DB=                       # optional, kb/build_pubmed_titles.py
# RETRIEVE_CURATED_SOURCES=my_guidelines  # your own --source jsonl corpora (full-length passages)
# RETRIEVE_SOURCE_WEIGHTS='{"my_guidelines": 1.0}'

# ---- web search tool (TOOLS=retrieval_web or web) ---------------------------------
SERPER_API_KEY=                           # https://serper.dev

# ---- proposer style seeds (optional, medical domains) -----------------------------
# SEED_EXEMPLARS_PATH=data/seed_corpora/style_exemplars.jsonl   # kb/fetch_seed_corpora.py

# ---- data, outputs, runtime ------------------------------------------------------
RRI_DATA=data                             # holds healthbench_pro_val.parquet (VAL_PARQUET overrides)
RRI_OUTPUT=outputs                        # logs/, checkpoints/, cache/
# PYTHON=python
# RRI_HF_HOME=/path/to/hf_cache           # exported as HF_HOME for every process
# WANDB_API_KEY=                          # optional; console logging only without it
